# Salin menjadi .env.local. Kedua nilai ini publik (aman di browser); hak akses dijaga RLS di database.
# Kosongkan keduanya untuk memakai data palsu di memori (pengembangan dan tes).
# JANGAN pernah memakai awalan NEXT_PUBLIC_ untuk service_role key atau kunci DOKU: nilainya dikirim ke browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
